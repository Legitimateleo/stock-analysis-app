# Copy to .env and adjust if needed. Never commit the real .env file.

# D5: where Streamlit finds the Spring Boot backend.
# - Local dev, backend running on your host machine:
API_BASE_URL=http://localhost:8080

# - Docker Compose (uncomment and use instead, once Track C's
#   docker-compose.yml names the backend service "backend"):
# API_BASE_URL=http://backend:8080
