# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit real API keys.

aws_region     = "us-east-1"
project_name   = "parallax"
github_owner   = "Legitimateleo"
github_repo    = "stock-analysis-app"
github_branch  = "feature/cloud-backend"

finnhub_api_key = "your_finnhub_key_here"
polygon_api_key = "your_polygon_key_here"

deploy_user_name = "leo"      # your name/handle
viewer_user_name = "shawdy"   # teammate's name/handle
