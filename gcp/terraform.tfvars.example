# gcp/terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your real API keys.
# terraform.tfvars is gitignored — never commit real keys.
#
#   Copy-Item terraform.tfvars.example terraform.tfvars   (PowerShell)
#
# project_id / project_name / region already have correct defaults in
# variables.tf, so you only need the two keys here. Use the same Finnhub
# key you used for AWS/Compose.

finnhub_api_key = "your_finnhub_key_here"
polygon_api_key = ""   # leave blank if you don't have one — chart just returns empty
